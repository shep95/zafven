# Copy to ".env" locally, or set these as Variables in the Railway dashboard.

# ── Required ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token
GEMINI_API_KEY=your-gemini-api-key

# ── Gemini LLM (https://ai.google.dev) ───────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1200
GEMINI_TIMEOUT=45
# 0 disables model "thinking" (recommended — stops replies cutting off mid-sentence).
GEMINI_THINKING_BUDGET=0
# "auto"/"on" enable Google Search grounding; "off" disables it.
GEMINI_WEB_SEARCH=auto
# How much Gemini's own filter blocks: BLOCK_NONE (loosest) / BLOCK_ONLY_HIGH /
# BLOCK_MEDIUM_AND_ABOVE / BLOCK_LOW_AND_ABOVE. "OFF" = BLOCK_NONE.
GEMINI_SAFETY=BLOCK_NONE
# Add a direct-answer style preference (legacy name; does not bypass provider rules).
UNCENSORED_MODE=true
# Voice (Gemini text-to-speech). Voice names: Kore, Puck, Aoede, Leda, Zephyr, …
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ── Manual member reports ────────────────────────────────────────────────
MOD_ALERT_CHANNEL=mod-alerts
MOD_ROLES=Moderator,Admin,Mod

# ── Music player (YouTube → voice channel) ────────────────────────────────
MUSIC_ENABLED=true
# Max tracks a single guild can queue at once.
MUSIC_MAX_QUEUE=100
# Getting YouTube to work on a hosted bot (Railway etc): YouTube blocks datacenter
# IPs with a "sign in to confirm you're not a bot" check. Fix it with cookies:
#   • MUSIC_COOKIE_FILE = path to a cookies.txt export, OR
#   • MUSIC_COOKIES     = paste the WHOLE cookies.txt content (easier on Railway —
#                         no file needed; it's written to a temp file at runtime).
# Export cookies.txt from a browser logged in to YouTube (e.g. the "Get cookies.txt
# LOCALLY" extension). Use a throwaway Google account — cookies grant account access.
MUSIC_COOKIE_FILE=
MUSIC_COOKIES=
# Optional proxy for yt-dlp (http://user:pass@host:port). A residential proxy also
# gets past YouTube's datacenter bot check.
MUSIC_PROXY=
# Fall back to SoundCloud for searches and YouTube links with a retrievable title.
MUSIC_SOUNDCLOUD_FALLBACK=true

# ── Welcome DMs + invite tracking / referral leaderboard ──────────────────
INVITES_ENABLED=true
WELCOME_DM_ENABLED=true
# Blank = the supplied Houseofasher relaunch invitation. Optional {invite_link}
# placeholder; otherwise the link is appended. Clear old deployment overrides
# to use the new default. Needs Create Invite; tracking also needs Manage Server.
WELCOME_DM_MESSAGE=
# Channel to post "X invited Y" credits. Blank = don't announce.
INVITE_LOG_CHANNEL=invite-log
# Allow /247 (persistent 24/7 mode that stays in the VC and rejoins on restart).
MUSIC_247_ALLOWED=true
# Discord-safe output filters. Default resamples to 48 kHz stereo and limits peaks
# to reduce buzzing on phone speakers/headphones. Tremolo: 0 off, or 4-8 Hz.
MUSIC_AUDIO_FILTER=aresample=48000:resampler=soxr:precision=28,alimiter=limit=0.95
# Tremolo rate in Hz (the signature pulse). 0 = off. Default 4.
MUSIC_TREMOLO_HZ=4
# Tremolo depth — how strong the pulse is. 0.25 buzzes; ~0.08 is a subtle breath.
MUSIC_TREMOLO_DEPTH=0.08

# ── Discord behaviour ─────────────────────────────────────────────────────
GUILD_ID=
# Public distribution: keep GUILD_ID blank for global commands and enable Public Bot
# in Discord's Developer Portal. The API cannot make a bot unremovable.
PUBLIC_BOT_MODE=true
# Your Houseofasher server ID; required for public-mode batch promotions.
HOUSEOFASHER_GUILD_ID=
# Approved-source reasoning-pattern learner. Start it in Discord with /asher_learn.
ASHER_USER_ID=909200076637872188
ASHER_MAX_SAMPLES=200
ASHER_SCAN_PER_CHANNEL=500
WELCOME_CHANNEL=welcome
MEMBER_LOG_CHANNEL=member-log
# Deleted-message audit log. Configure its channel visibility in Discord.
DELETED_LOG_CHANNEL=message-log
MESSAGE_LOG_ENABLED=true
PROTECTED_ROLES=Admin,Moderator,Mod,Booster
# Members with this role can't be read by chat-triggered profile requests.
PROFILE_OPTOUT_ROLES=no-readings

# ── Live chat personality (Zafven, she/her) ───────────────────────────────
CHAT_ENABLED=true
# 0.0 = only reply when @mentioned or replied to. 0.05 = ~5% ambient chime-ins.
CHAT_AMBIENT_CHANCE=0.0
CHAT_COOLDOWN_SECONDS=6
CHAT_CONTEXT_MESSAGES=12
# Limit chatting to these channel names (comma-separated). Empty = everywhere.
CHAT_CHANNELS=
# Let addressed chat replies quote relevant messages from other readable channels.
CHAT_CROSS_CHANNEL_SOURCES=true
CHAT_SOURCE_CHANNELS=8
CHAT_SOURCE_MESSAGES_PER_CHANNEL=30
CHAT_SOURCE_SNIPPETS=6

# Bible reference replies. Uses public-domain/open translations from bible-api.com.
BIBLE_REPLY_ENABLED=true
BIBLE_TRANSLATIONS=kjv,web,asv,dra
BIBLE_MAX_TRANSLATIONS=4
BIBLE_MAX_REFERENCES=2
BIBLE_TIMEOUT_SECONDS=8

# ── YouTube + knowledge reports ───────────────────────────────────────────
# Optional: real video search for /youtube (else AI-suggested links).
YOUTUBE_API_KEY=
# Public channel where /learn posts knowledge reports.
KNOWLEDGE_CHANNEL=knowledge

# ── Phase 2: persistence + scheduled/stateful features ────────────────────
# Hidden channel for persistent data (XP, time capsules, ciphers).
DATA_CHANNEL=zafven-data
# SQLite archive and delivery queue. On Railway, mount a persistent volume here.
BOT_DATA_DIR=./zafven-storage
MESSAGE_BACKUP_ENABLED=true
MESSAGE_BACKUP_CATEGORY=message-backups
USER_MEMORY_CATEGORY=zafven-memory
RANKS_ENABLED=true
RANK_COOLDOWN_SECONDS=60
RANK_LADDER=Helper:1,Regular:3,Trusted:6,Steward:10,Elder:15
DEFAULT_INACTIVE_DAYS=30
ACTIVITY_SCAN_LIMIT=2000
JOIN_GRACE_DAYS=7
